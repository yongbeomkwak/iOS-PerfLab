#!/usr/bin/env python3
"""PerfLab 파이프라인 CLI.

모든 주제는 이 도구를 통해 생성, 검증, 측정, 상태 전환된다.
Claude(skill)와 사람이 같은 명령을 사용하므로 파이프라인이 항상 동일하게 유지된다.

    scripts/perflab new --category rendering --slug image-feed-scroll --title "..." --summary "..." --tags A,B
    scripts/perflab status [TOPIC]
    scripts/perflab validate TOPIC [--status STATUS]
    scripts/perflab advance TOPIC
    scripts/perflab test TOPIC
    scripts/perflab measure TOPIC [--device NAME] [--repeat N] [--duration SEC]
    scripts/perflab table TOPIC
    scripts/perflab fingerprint TOPIC
    scripts/perflab chart TOPIC --metric NAME [--device DIR]
    scripts/perflab png TOPIC
    scripts/perflab readme
    scripts/perflab devices
    scripts/perflab build [--device NAME]
    scripts/perflab format [PATH ...]
    scripts/perflab lint [PATH ...]
"""

import argparse
import hashlib
import json
import math
import os
import re
import shutil
import statistics
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TOPICS_PACKAGE = ROOT / "Packages" / "Topics"
TEMPLATE = ROOT / "Templates" / "Topic"
CATALOG = TOPICS_PACKAGE / "Catalog" / "TopicCatalog.swift"
PACKAGE_SWIFT = TOPICS_PACKAGE / "Package.swift"
README = ROOT / "README.md"
PROJECT = ROOT / "PerfLab.xcodeproj"
DEFAULT_SIMULATOR = "iPhone 17 Pro"

CATEGORIES = {
    "rendering": ("Rendering", "Rendering"),
    "animation": ("Animation", "Animation"),
    "concurrency": ("Concurrency", "Concurrency"),
    "memory": ("Memory", "Memory"),
    "algorithms": ("Algorithms", "Algorithms"),
}
STATUSES = ["proposed", "planned", "stage0", "stage1", "stage2", "measured", "summarized", "archived"]
STAGE_TITLES = {0: "Naive", 1: "Optimized", 2: "Advanced"}
FRAMEWORK_TITLES = {"uikit": "UIKit", "swiftui": "SwiftUI"}
NOT_IMPLEMENTED = "PERFLAB: NOT_IMPLEMENTED"
TODO = "TODO:"
STRATEGY_HEADER = "// 전략:"
CHANGE_HEADER = "// 변경:"
BASELINE_ID = "_baseline"
BASELINE_RESULT = "baseline"
DEFAULT_REPEAT = 3
# 반복 측정 간 (최대 - 최소) / 중앙값이 이 비율을 넘고, 차이가 지표별 최소값보다 크면 경고한다.
# 최소값보다 작은 차이(예: CPU 2% vs 3%)는 비율이 커도 노이즈로 본다.
SPREAD_WARNING = 0.2
SPREAD_FLOOR = {
    "fpsAverage": 3, "fpsMinimum": 5, "hitchCount": 3, "hitchTimeRatio": 10,
    "cpuAverage": 5, "cpuPeak": 10, "memoryAverageMB": 5, "memoryPeakMB": 5, "threadPeak": 3,
}

RESULTS_START = "<!-- perflab:results:start -->"
RESULTS_END = "<!-- perflab:results:end -->"
# PLAN.md "대가 지표"에 쓸 수 있는 공통 지표 이름. 나머지는 PLAN.md 커스텀 지표 표에 있어야 한다.
COMMON_METRICS = {"FPS", "Hitch", "CPU", "Memory", "Threads"}
COST_COLUMN = "대가"
COST_METRIC_COLUMN = "대가 지표"
# docs/VERIFICATION.md: code-verifier, summary-reviewer의 판정 기록. 미해결 항목이 있으면 advance가 실패한다.
VERDICT_COLUMN = "판정"
ACTION_COLUMN = "조치"
UNRESOLVED_VERDICTS = ("추정", "틀림")
FINGERPRINT_PATTERN = r"지문:\s*`([0-9a-f]{12})`"
ASSETS_DIR = "assets"
CHART_PREFIX = "chart-"
# PNG는 SVG의 2배 크기로 만든다. 블로그의 고해상도 화면에서 글자가 흐려지지 않게 하기 위해서다.
PNG_SCALE = 2
README_START = "<!-- perflab:topics:start -->"
README_END = "<!-- perflab:topics:end -->"


# ---------------------------------------------------------------------------
# Topic model


class Topic:
    def __init__(self, path):
        self.path = path
        self.meta = json.loads((path / "topic.json").read_text())

    @property
    def id(self):
        return self.meta["id"]

    @property
    def status(self):
        return self.meta["status"]

    @property
    def stages(self):
        return sorted(self.meta["stages"])

    @property
    def frameworks(self):
        return self.meta["frameworks"]

    @property
    def module(self):
        return module_name(self.meta["number"], self.id.split("-", 1)[1])

    @property
    def relpath(self):
        return self.path.relative_to(ROOT)

    def save(self):
        (self.path / "topic.json").write_text(json.dumps(self.meta, ensure_ascii=False, indent=2) + "\n")

    def doc(self, name):
        return self.path / "docs" / name

    def pipeline(self):
        """이 주제가 거쳐야 하는 상태 목록. 사용하지 않는 Stage는 건너뛴다."""
        skipped = {"stage%d" % s for s in range(3) if s not in self.stages}
        return [s for s in STATUSES if s not in skipped]

    def next_status(self):
        pipeline = self.pipeline()
        index = pipeline.index(self.status)
        return pipeline[index + 1] if index + 1 < len(pipeline) else None


def pascal(slug):
    return "".join(part.capitalize() for part in re.split(r"[-_]", slug) if part)


def module_name(number, slug):
    return "Topic%02d%s" % (number, pascal(slug))


def all_topics():
    topics = [Topic(p.parent) for p in TOPICS_PACKAGE.glob("*/*/topic.json")]
    return sorted(topics, key=lambda t: t.meta["number"])


def find_topic(query):
    for topic in all_topics():
        if query in (topic.id, str(topic.meta["number"]), "%02d" % topic.meta["number"]):
            return topic
    fail("주제를 찾을 수 없습니다: %s" % query)


def fail(message):
    print("✘ " + message, file=sys.stderr)
    sys.exit(1)


def run(cmd, env=None, check=True):
    print("$ " + " ".join(cmd))
    result = subprocess.run(cmd, cwd=ROOT, env=env)
    if check and result.returncode != 0:
        fail("명령 실패 (exit %d)" % result.returncode)
    return result.returncode


# ---------------------------------------------------------------------------
# new


def cmd_new(args):
    if args.category not in CATEGORIES:
        fail("category는 %s 중 하나여야 합니다." % ", ".join(CATEGORIES))
    if not re.fullmatch(r"[a-z0-9]+(-[a-z0-9]+)*", args.slug):
        fail("slug는 kebab-case 영문 소문자여야 합니다. 예) image-feed-scroll")

    number = max([t.meta["number"] for t in all_topics()] or [0]) + 1
    topic_id = "%02d-%s" % (number, args.slug)
    folder, _ = CATEGORIES[args.category]
    destination = TOPICS_PACKAGE / folder / topic_id
    if destination.exists():
        fail("이미 존재합니다: %s" % destination)

    module = module_name(number, args.slug)
    tags = [t.strip() for t in args.tags.split(",") if t.strip()]
    replacements = {
        "__ID__": topic_id,
        "__NUMBER__": "%02d" % number,
        "__NUMBER_RAW__": str(number),
        "__TITLE__": args.title,
        "__SUMMARY__": args.summary,
        "__CATEGORY__": args.category,
        "__TAGS__": json.dumps(tags, ensure_ascii=False),
        "__MODULE__": module,
        "__TYPE__": pascal(args.slug) + "Topic",
    }

    shutil.copytree(TEMPLATE, destination)
    for file in destination.rglob("*"):
        if file.is_file() and file.suffix in (".swift", ".json", ".md"):
            text = file.read_text()
            for key, value in replacements.items():
                text = text.replace(key, value)
            file.write_text(text)

    # Package.swift / TopicCatalog 등록
    entry = 'TopicModule(name: "%s", path: "%s/%s")' % (module, folder, topic_id)
    PACKAGE_SWIFT.write_text(insert_list_entry(PACKAGE_SWIFT.read_text(), "// @perflab:topics", entry))
    catalog = CATALOG.read_text().replace("// @perflab:imports", "import %s\n// @perflab:imports" % module, 1)
    CATALOG.write_text(insert_list_entry(catalog, "// @perflab:entries", "%s()" % replacements["__TYPE__"]))
    # swift-format이 원소 1개짜리 배열의 쉼표를 지우므로, 등록 후 두 파일을 다시 정리한다.
    run(["xcrun", "swift-format", "format", "--in-place", str(PACKAGE_SWIFT), str(CATALOG)])

    print("✔ 생성: %s (%s)" % (destination.relative_to(ROOT), module))
    print("  다음 단계: docs/PLAN.md 작성 후 `scripts/perflab advance %s`" % topic_id)


def insert_list_entry(text, marker, entry):
    """배열 안의 `marker` 주석 줄 바로 위에 `entry`를 추가한다. 이전 원소에 쉼표가 없으면 붙인다."""
    lines = text.split("\n")
    index = next(i for i, line in enumerate(lines) if line.strip() == marker)
    indent = lines[index][: len(lines[index]) - len(lines[index].lstrip())]
    previous = index - 1
    while previous >= 0 and not lines[previous].strip():
        previous -= 1
    last = lines[previous].rstrip()
    if not last.endswith(("[", ",")) and not last.lstrip().startswith("//"):
        lines[previous] = last + ","
    lines.insert(index, "%s%s," % (indent, entry))
    return "\n".join(lines)


# ---------------------------------------------------------------------------
# validate


def check_docs_filled(topic, name, errors):
    path = topic.doc(name)
    if not path.exists():
        errors.append("%s 없음" % name)
    elif TODO in path.read_text():
        errors.append("%s에 TODO가 남아 있음" % name)


def markdown_tables(text):
    """마크다운 표마다 (머리 행 셀 목록, [본문 행 셀 목록])을 돌려준다."""
    tables, rows = [], []
    for line in text.splitlines() + [""]:
        if line.startswith("|"):
            rows.append([cell.strip() for cell in line.strip().strip("|").split("|")])
            continue
        if len(rows) >= 2:
            tables.append((rows[0], [r for r in rows[2:] if len(r) == len(rows[0])]))
        rows = []
    return tables


def plan_cost_metrics(topic):
    """PLAN.md Stage 전략 표에서 Stage별 대가 지표 이름과, 커스텀 지표 이름 목록을 읽는다.

    반환: ({"S1": ["searchMemory", "CPU"]...} 또는 None, {커스텀 지표 이름}, [오류])
    """
    path = topic.doc("PLAN.md")
    text = path.read_text() if path.exists() else ""
    custom, costs, errors = set(), None, []
    for header, rows in markdown_tables(text):
        if header[:2] == ["이름", "단위"]:
            custom |= {name for row in rows for name in re.findall(r"`([^`]+)`", row[0])}
        if COST_METRIC_COLUMN in header and COST_COLUMN in header:
            costs = {}
            cost_index, metric_index = header.index(COST_COLUMN), header.index(COST_METRIC_COLUMN)
            for position, row in enumerate(rows):
                stage = row[0].split()[0]
                if row[cost_index] in ("", "-"):
                    # 첫 Stage는 기준점이라 대가가 없다. 그 뒤 Stage의 최적화에는 항상 대가가 있다.
                    if position > 0:
                        errors.append("PLAN.md %s의 대가가 비어 있음" % stage)
                    continue
                names = re.findall(r"`([^`]+)`", row[metric_index])
                if not names and "정성:" not in row[metric_index]:
                    errors.append("PLAN.md %s의 대가를 확인할 지표가 없음 (`%s` 열)" % (stage, COST_METRIC_COLUMN))
                costs[stage] = names
    if costs is None:
        errors.append("PLAN.md Stage 전략 표에 `%s`, `%s` 열이 없음" % (COST_COLUMN, COST_METRIC_COLUMN))
        return {}, custom, errors
    for stage, names in costs.items():
        unknown = [n for n in names if n not in custom | COMMON_METRICS]
        if unknown:
            errors.append(
                "PLAN.md %s 대가 지표 %s가 커스텀 지표 표나 공통 지표(%s)에 없음"
                % (stage, ", ".join(unknown), ", ".join(sorted(COMMON_METRICS)))
            )
    return costs, custom, errors


def check_cost_results(topic, device, errors):
    """대가 지표로 쓴 커스텀 지표를 모든 Stage가 기록했는지 본다. 없으면 Stage 간 비교가 안 된다."""
    costs, custom, _ = plan_cost_metrics(topic)
    names = {n for ns in costs.values() for n in ns} & custom
    for s in topic.stages:
        for f in topic.frameworks:
            path = topic.path / "results" / device / ("stage%d-%s.json" % (s, f))
            recorded = {m["name"] for m in json.loads(path.read_text()).get("customMetrics", [])}
            missing = sorted(names - recorded)
            if missing:
                errors.append("%s에 대가 지표 %s 기록이 없음 (해당 구조가 없는 Stage도 0을 기록)" % (path.name, ", ".join(missing)))


def check_learning(topic, tag, errors):
    text = topic.doc("LEARNING.md").read_text() if topic.doc("LEARNING.md").exists() else ""
    text = re.sub(r"<!--.*?-->", "", text, flags=re.DOTALL)
    if not re.search(r"^### \[%s\]" % re.escape(tag), text, re.MULTILINE):
        errors.append("LEARNING.md에 `### [%s]` 체크포인트 기록이 없음" % tag)


def fingerprint(topic):
    """주제의 Swift 소스(Tests 제외) 전체의 지문. 검증 뒤에 코드가 바뀌었는지 알아내는 데 쓴다."""
    digest = hashlib.sha256()
    for path in sorted(topic.path.rglob("*.swift")):
        relative = path.relative_to(topic.path)
        if relative.parts[0] == "Tests":
            continue
        digest.update(str(relative).encode())
        digest.update(path.read_bytes())
    return digest.hexdigest()[:12]


def unresolved_verdicts(text):
    """판정이 추정/틀림인데 조치가 비어 있는 행의 첫 칸(번호) 목록."""
    unresolved = []
    for header, rows in markdown_tables(text):
        if VERDICT_COLUMN not in header or ACTION_COLUMN not in header:
            continue
        verdict, action = header.index(VERDICT_COLUMN), header.index(ACTION_COLUMN)
        for row in rows:
            if any(v in row[verdict] for v in UNRESOLVED_VERDICTS) and row[action] in ("", "-"):
                unresolved.append(row[0])
    return unresolved


def check_verification(topic, tags, errors, code=True):
    """VERIFICATION.md에 `tags`의 기록이 있고, 미해결 항목이 없고, 검증한 코드가 지금 코드와 같은지 본다."""
    path = topic.doc("VERIFICATION.md")
    if not path.exists():
        errors.append("VERIFICATION.md 없음 (code-verifier 검증 기록)")
        return
    text = re.sub(r"<!--.*?-->", "", path.read_text(), flags=re.DOTALL)
    for tag in tags:
        if not re.search(r"^### \[%s\]" % re.escape(tag), text, re.MULTILINE):
            errors.append("VERIFICATION.md에 `### [%s]` 검증 기록이 없음" % tag)
    unresolved = unresolved_verdicts(text)
    if unresolved:
        errors.append("VERIFICATION.md에 조치하지 않은 추정/틀림 항목 %d건 (%s)" % (len(unresolved), ", ".join(unresolved)))
    if code:
        recorded = re.findall(FINGERPRINT_PATTERN, text)
        current = fingerprint(topic)
        if not recorded:
            errors.append("VERIFICATION.md에 검증한 코드의 지문이 없음 (`scripts/perflab fingerprint %s`)" % topic.id)
        elif recorded[-1] != current:
            errors.append("검증 뒤에 코드가 바뀜 (검증 %s, 현재 %s). code-verifier로 다시 검증한다" % (recorded[-1], current))


def check_summary_assets(topic, errors):
    """SUMMARY.md가 가리키는 이미지가 있고, 차트가 지금의 결과 JSON과 같은지 본다."""
    docs = topic.path / "docs"
    summary = topic.doc("SUMMARY.md").read_text() if topic.doc("SUMMARY.md").exists() else ""
    for target in re.findall(r"!\[[^\]]*\]\(([^)\s]+)", summary):
        if not re.match(r"https?://", target) and not (docs / target).exists():
            errors.append("SUMMARY.md가 가리키는 이미지가 없음: %s" % target)
    for chart in sorted((docs / ASSETS_DIR).glob(CHART_PREFIX + "*.svg")):
        device, _, metric = chart.stem[len(CHART_PREFIX):].rpartition("-")
        try:
            expected = chart_svg(topic, device, metric)
        except ChartError as error:
            errors.append("%s를 다시 만들 수 없음: %s" % (chart.name, error))
            continue
        if chart.read_text() != expected:
            errors.append("%s가 결과 JSON과 다름 (`scripts/perflab chart %s --metric %s --device %s`)"
                          % (chart.name, topic.id, metric, device))


def check_stage_header(topic, stage, path, errors):
    """Stage 파일 상단의 전략 주석 (docs/CONVENTIONS.md "Stage 파일 머리말")."""
    lines = path.read_text().splitlines()
    if not any(line.startswith(STRATEGY_HEADER) for line in lines):
        errors.append("%s에 `%s` 머리말이 없음" % (path.relative_to(topic.path), STRATEGY_HEADER))
    if stage != topic.stages[0] and not any(line.startswith(CHANGE_HEADER) for line in lines):
        errors.append("%s에 `%s` 머리말이 없음" % (path.relative_to(topic.path), CHANGE_HEADER))


def stage_files(topic, stage):
    return [
        ("swiftui", topic.path / "SwiftUI" / ("Stage%dView.swift" % stage)),
        ("uikit", topic.path / "UIKit" / ("Stage%dViewController.swift" % stage)),
    ]


def result_sets(topic):
    """results/<device>/ 별로 존재하는 결과 파일 집합."""
    sets = {}
    for device in sorted((topic.path / "results").glob("*")):
        if device.is_dir():
            # baseline.json도 필수 결과라 함께 센다 (expected_results에 들어 있다).
            sets[device.name] = {p.stem for p in device.glob("*.json")}
    return sets


def expected_results(topic):
    return {"stage%d-%s" % (s, f) for s in topic.stages for f in topic.frameworks} | {BASELINE_RESULT}


def validate(topic, status):
    """`status`까지 완료되었다고 볼 수 있는지 검사하고 오류 목록을 반환한다."""
    errors = []
    meta = topic.meta
    pipeline = topic.pipeline()
    if status not in pipeline:
        return ["%s는 이 주제의 파이프라인에 없는 상태" % status]
    reached = pipeline[: pipeline.index(status) + 1]

    # proposed
    for key in ("id", "number", "title", "summary", "category", "tags", "status", "stages", "frameworks"):
        if key not in meta:
            errors.append("topic.json에 %s 없음" % key)
    if "__" in json.dumps(meta) or not meta.get("summary"):
        errors.append("topic.json에 채워지지 않은 값이 있음")
    if not meta.get("tags"):
        errors.append("topic.json tags가 비어 있음")
    if topic.module not in PACKAGE_SWIFT.read_text():
        errors.append("Package.swift에 %s 미등록" % topic.module)
    if "import %s" % topic.module not in CATALOG.read_text():
        errors.append("TopicCatalog에 %s 미등록" % topic.module)

    if "planned" in reached:
        check_docs_filled(topic, "PLAN.md", errors)
        errors.extend(plan_cost_metrics(topic)[2])
        if TODO in (topic.path / "Scenario.swift").read_text():
            errors.append("Scenario.swift에 TODO가 남아 있음")
        check_learning(topic, "Plan", errors)

    for stage in topic.stages:
        if "stage%d" % stage not in reached:
            continue
        for framework, path in stage_files(topic, stage):
            if framework not in topic.frameworks:
                continue
            if not path.exists():
                errors.append("%s 없음" % path.relative_to(topic.path))
            elif NOT_IMPLEMENTED in path.read_text():
                errors.append("%s가 아직 NOT_IMPLEMENTED" % path.relative_to(topic.path))
            else:
                check_stage_header(topic, stage, path, errors)
        check_learning(topic, "Stage %d" % stage, errors)

    verified = ["Stage %d" % s for s in topic.stages if "stage%d" % s in reached]
    if verified:
        check_verification(topic, verified, errors)

    if any("stage%d" % s in reached for s in topic.stages):
        lint_errors = swift_format_lint([topic.path])
        if lint_errors:
            errors.append("swift-format lint 위반 %d건 (`scripts/perflab format %s`)" % (len(lint_errors), topic.relpath))

    if "measured" in reached:
        expected = expected_results(topic)
        complete = [d for d, files in result_sets(topic).items() if expected <= files]
        if not complete:
            errors.append("results/<device>/에 모든 Stage×Framework 결과가 있는 기기가 없음 (필요: %s)" % ", ".join(sorted(expected)))
        for device in complete:
            check_cost_results(topic, device, errors)
        results = topic.doc("RESULTS.md").read_text() if topic.doc("RESULTS.md").exists() else ""
        if "scripts/perflab table" in results.split(RESULTS_START)[-1].split(RESULTS_END)[0]:
            errors.append("RESULTS.md 결과표가 생성되지 않음 (`scripts/perflab table %s`)" % topic.id)
        check_docs_filled(topic, "RESULTS.md", errors)
        check_learning(topic, "Measure", errors)

    if "summarized" in reached:
        check_docs_filled(topic, "SUMMARY.md", errors)
        if topic.doc("VERIFICATION.md").exists():
            check_verification(topic, ["Summary"], errors, code=False)
        check_summary_assets(topic, errors)

    if "archived" in reached:
        if topic.id not in README.read_text():
            errors.append("README Topics 표에 없음 (`scripts/perflab readme`)")

    return errors


def cmd_validate(args):
    topic = find_topic(args.topic)
    status = args.status or topic.status
    errors = validate(topic, status)
    if errors:
        print("✘ %s — `%s` 조건 미충족" % (topic.id, status))
        for e in errors:
            print("  - " + e)
        sys.exit(1)
    print("✔ %s — `%s` 조건 충족" % (topic.id, status))


def cmd_advance(args):
    topic = find_topic(args.topic)
    errors = validate(topic, topic.status)
    if errors:
        print("✘ 현재 상태 `%s`부터 충족되지 않습니다." % topic.status)
        for e in errors:
            print("  - " + e)
        sys.exit(1)
    target = topic.next_status()
    if target is None:
        fail("이미 마지막 단계(archived)입니다.")
    errors = validate(topic, target)
    if errors:
        print("✘ %s → `%s` 전환 불가" % (topic.id, target))
        for e in errors:
            print("  - " + e)
        sys.exit(1)
    previous = topic.status
    topic.meta["status"] = target
    topic.save()
    print("✔ %s: %s → %s" % (topic.id, previous, target))
    following = topic.next_status()
    if following:
        print("  다음 단계: %s" % following)


# ---------------------------------------------------------------------------
# status


def cmd_status(args):
    topics = [find_topic(args.topic)] if args.topic else all_topics()
    if not topics:
        print("등록된 주제가 없습니다. `scripts/perflab new`로 시작하세요.")
        return
    for topic in topics:
        nxt = topic.next_status() or "-"
        print("#%02d  %-40s %-11s next: %-10s %s" % (
            topic.meta["number"], topic.id, topic.status, nxt, topic.relpath))


# ---------------------------------------------------------------------------
# test / measure


def default_simulator_id():
    """현재 Xcode SDK가 지원하는 가장 최신 런타임의 DEFAULT_SIMULATOR를 찾는다."""
    sdk = subprocess.run(["xcrun", "--sdk", "iphonesimulator", "--show-sdk-version"],
                         capture_output=True, text=True).stdout.strip()
    sdk_version = tuple(int(x) for x in sdk.split(".")[:2])
    devices = json.loads(subprocess.run(["xcrun", "simctl", "list", "devices", "available", "-j"],
                                        capture_output=True, text=True).stdout)["devices"]
    candidates = []
    for runtime, items in devices.items():
        match = re.search(r"iOS-(\d+)-(\d+)", runtime)
        if not match:
            continue
        version = (int(match.group(1)), int(match.group(2)))
        if version > sdk_version:
            continue
        for item in items:
            if item["name"] == DEFAULT_SIMULATOR:
                candidates.append((version, item["udid"]))
    if not candidates:
        fail("%s 시뮬레이터를 찾을 수 없습니다 (SDK %s)." % (DEFAULT_SIMULATOR, sdk))
    return max(candidates)[1]


def destination_for(device):
    if device is None:
        return "platform=iOS Simulator,id=%s" % default_simulator_id()
    if device.startswith("platform=") or device.startswith("id="):
        return device
    return "platform=iOS,name=%s" % device


def topics_scheme():
    output = subprocess.run(["xcodebuild", "-list"], cwd=TOPICS_PACKAGE, capture_output=True, text=True).stdout
    schemes = re.findall(r"^\s{8}(\S+)$", output.split("Schemes:")[-1], re.MULTILINE)
    return "Topics-Package" if "Topics-Package" in schemes else "Topics"


def cmd_test(args):
    topic = find_topic(args.topic)
    scheme = topics_scheme()
    cmd = ["xcodebuild", "test", "-scheme", scheme, "-destination", destination_for(args.device),
           "-only-testing:%sTests" % topic.module, "-quiet"]
    print("$ (cd Packages/Topics) " + " ".join(cmd))
    result = subprocess.run(cmd, cwd=TOPICS_PACKAGE)
    if result.returncode != 0:
        fail("테스트 실패")
    print("✔ %sTests 통과" % topic.module)


def cmd_measure(args):
    topic = find_topic(args.topic)
    last_stage = "stage%d" % topic.stages[-1]
    errors = validate(topic, last_stage)
    if errors and not args.allow_incomplete:
        print("✘ 모든 Stage 구현이 끝나야 측정할 수 있습니다 (`%s` 조건 미충족)." % last_stage)
        for e in errors:
            print("  - " + e)
        fail("파이프라인 점검용으로 측정만 해 보려면 --allow-incomplete")
    if args.device is None:
        print("⚠ 시뮬레이터 측정은 참고용입니다. 실기기: --device \"<기기 이름>\"")

    work = Path(tempfile.mkdtemp(prefix="perflab-"))
    bundle = work / "measure.xcresult"
    env = dict(os.environ)
    env.update({
        "TEST_RUNNER_PERFLAB_TOPIC": topic.id,
        "TEST_RUNNER_PERFLAB_STAGES": ",".join(str(s) for s in topic.stages),
        "TEST_RUNNER_PERFLAB_FRAMEWORKS": ",".join(topic.frameworks),
        "TEST_RUNNER_PERFLAB_DURATION": str(args.duration),
        "TEST_RUNNER_PERFLAB_WARMUP": str(args.warmup),
        "TEST_RUNNER_PERFLAB_REPEAT": str(args.repeat),
        "TEST_RUNNER_PERFLAB_BASELINE": "1",
    })
    run(["xcodebuild", "test",
         "-project", str(PROJECT), "-scheme", "PerfLab", "-configuration", "Release",
         "-destination", destination_for(args.device),
         "-only-testing:PerfLabUITests/BenchmarkUITests/testBenchmark",
         "-resultBundlePath", str(bundle), "-quiet"], env=env)

    exported = work / "attachments"
    run(["xcrun", "xcresulttool", "export", "attachments", "--path", str(bundle), "--output-path", str(exported)])

    # (기기 폴더, 결과 이름) → 회차별 결과
    groups = {}
    for file in exported.glob("*.json"):
        if file.name == "manifest.json":
            continue
        try:
            result = json.loads(file.read_text())
        except ValueError:
            continue
        if result.get("topicID") == BASELINE_ID:
            name = BASELINE_RESULT
        elif result.get("topicID") == topic.id:
            name = "stage%d-%s" % (result["stage"], result["framework"])
        else:
            continue
        env_info = result["environment"]
        device_dir = re.sub(r"[^A-Za-z0-9,._-]", "_", env_info["deviceModel"])
        if env_info["isSimulator"]:
            device_dir += "-simulator"
        groups.setdefault((device_dir, name), []).append(result)

    shutil.rmtree(work, ignore_errors=True)
    if not groups:
        fail("저장된 결과가 없습니다.")

    for (device_dir, name), runs in sorted(groups.items()):
        aggregated = aggregate_runs(runs)
        target = topic.path / "results" / device_dir / ("%s.json" % name)
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(json.dumps(aggregated, ensure_ascii=False, indent=2, sort_keys=True) + "\n")
        print("✔ %s (%d회 중앙값)" % (target.relative_to(ROOT), len(runs)))
        for warning in spread_warnings(runs):
            print("  ⚠ %s: %s" % (name, warning))
    print("  다음: `scripts/perflab table %s`" % topic.id)


def aggregate_runs(runs):
    """회차별 결과를 지표별 중앙값으로 합친다. 원본 회차 지표는 `runs`에 남긴다."""
    runs = sorted(runs, key=lambda r: r["date"])
    result = dict(runs[-1])
    result["repeat"] = len(runs)
    result["runs"] = [r["metrics"] for r in runs]
    result["metrics"] = {key: statistics.median(r["metrics"][key] for r in runs) for key in runs[0]["metrics"]}
    custom = {}
    for r in runs:
        for m in r["customMetrics"]:
            custom.setdefault((m["name"], m["unit"]), []).append(m["value"])
    result["customMetrics"] = [
        {"name": name, "unit": unit, "value": statistics.median(values)} for (name, unit), values in custom.items()
    ]
    return result


def spread_warnings(runs):
    warnings = []
    if len(runs) < 2:
        return warnings
    for title, key, _ in METRIC_ROWS:
        values = [r["metrics"][key] for r in runs]
        median = statistics.median(values)
        spread = max(values) - min(values)
        if median > 0 and spread / median > SPREAD_WARNING and spread > SPREAD_FLOOR[key]:
            warnings.append("%s 편차 큼 (%s)" % (title, ", ".join("%.1f" % v for v in values)))
    return warnings


# ---------------------------------------------------------------------------
# table / readme


METRIC_ROWS = [
    ("FPS avg", "fpsAverage", "%.1f"),
    ("FPS min", "fpsMinimum", "%.1f"),
    ("Hitch count", "hitchCount", "%d"),
    ("Hitch ratio (ms/s)", "hitchTimeRatio", "%.1f"),
    ("CPU avg (%)", "cpuAverage", "%.1f"),
    ("CPU peak (%)", "cpuPeak", "%.1f"),
    ("Memory avg (MB)", "memoryAverageMB", "%.1f"),
    ("Memory peak (MB)", "memoryPeakMB", "%.1f"),
    ("Threads peak", "threadPeak", "%d"),
]

# 결과표의 "의미" 열. 공통 지표는 여기서, 주제별 지표는 PLAN.md 커스텀 지표 표의 "의미" 열에서 가져온다.
METRIC_MEANINGS = {
    "fpsAverage": "1초에 메인 스레드가 처리한 프레임 수의 평균. 최대 주사율에 가까울수록 부드럽다",
    "fpsMinimum": "0.5초 구간 중 가장 낮았던 FPS. 순간적으로 가장 심하게 끊긴 정도",
    "hitchCount": "프레임 간격이 기대 시간의 1.5배를 넘은 횟수. 적을수록 좋다",
    "hitchTimeRatio": "기대 시간을 넘긴 시간의 합을 초당으로 나눈 값. 5 미만 양호, 10 이상 심각 (Apple 기준)",
    "cpuAverage": "프로세스 CPU 사용률 평균. 100% = 코어 1개를 다 씀. 일의 양을 보여 준다",
    "cpuPeak": "0.5초 구간 중 가장 높았던 CPU 사용률",
    "memoryAverageMB": "앱이 실제로 쓰는 물리 메모리(physical footprint) 평균. iOS가 앱을 종료시키는 기준과 같다",
    "memoryPeakMB": "물리 메모리의 최대값",
    "threadPeak": "프로세스 스레드 수의 최대값",
}


def plan_metric_meanings(topic):
    """PLAN.md 커스텀 지표 표에서 {지표 이름: 의미의 첫 문장}을 읽는다."""
    path = topic.doc("PLAN.md")
    meanings = {}
    for header, rows in markdown_tables(path.read_text() if path.exists() else ""):
        if header[:2] != ["이름", "단위"] or "의미" not in header:
            continue
        index = header.index("의미")
        where = header.index("측정 위치") if "측정 위치" in header else None
        for row in rows:
            # 결과표가 넓어지지 않게 첫 문장만 쓴다. 자세한 정의는 PLAN.md에 있다.
            meaning = row[index].split(". ")[0].rstrip(".")
            # 시간 지표는 어디서부터 어디까지 잰 값인지 함께 보여 준다 (괄호 속 보충 설명은 뺀다).
            if where is not None and "→" in row[where]:
                meaning += " (구간: %s)" % re.sub(r"\s*\([^)]*\)", "", row[where]).strip()
            for name in re.findall(r"`([^`]+)`", row[0]):
                meanings[name] = meaning
    return meanings


def results_markdown(topic):
    sections = []
    for device in sorted((topic.path / "results").glob("*")):
        if not device.is_dir():
            continue
        results = {}
        for file in device.glob("stage*-*.json"):
            r = json.loads(file.read_text())
            results[(r["stage"], r["framework"])] = r
        if not results:
            continue
        titles = {}
        baseline = device / ("%s.json" % BASELINE_RESULT)
        if baseline.exists():
            results[BASELINE_RESULT] = json.loads(baseline.read_text())
            titles[BASELINE_RESULT] = "Baseline"
        sample = next(iter(results.values()))
        environment = sample["environment"]
        stage_columns = [(s, f) for f in topic.frameworks for s in topic.stages if (s, f) in results]
        titles.update({(s, f): "%s S%d" % (FRAMEWORK_TITLES[f], s) for s, f in stage_columns})
        columns = ([BASELINE_RESULT] if BASELINE_RESULT in results else []) + stage_columns
        header = "| 지표 | " + " | ".join(titles[c] for c in columns) + " | 의미 |"
        lines = [
            "### %s (iOS %s%s, %s, max %dfps)" % (
                environment["deviceModel"], environment["systemVersion"],
                ", Simulator" if environment["isSimulator"] else "", environment["buildConfiguration"],
                environment["maximumFPS"]),
            "",
            "측정 %.0f초 × %d회 중앙값. Baseline은 부하 없는 빈 화면(측정 노이즈 바닥)이다." % (
                sample["metrics"]["durationSeconds"], sample.get("repeat", 1)),
            "",
            header,
            "|---|" + "---:|" * len(columns) + "---|",
        ]
        def cell(value, fmt):
            # 반복 횟수가 짝수면 정수 지표의 중앙값이 x.5가 될 수 있다.
            return "%.1f" % value if fmt == "%d" and value != int(value) else fmt % value

        for title, key, fmt in METRIC_ROWS:
            lines.append(
                "| %s | " % title + " | ".join(cell(results[c]["metrics"][key], fmt) for c in columns)
                + " | %s |" % METRIC_MEANINGS[key])
        custom_names = []
        for c in columns:
            for m in results[c]["customMetrics"]:
                if (m["name"], m["unit"]) not in custom_names:
                    custom_names.append((m["name"], m["unit"]))
        meanings = plan_metric_meanings(topic)
        for name, unit in custom_names:
            cells = []
            for c in columns:
                value = next((m["value"] for m in results[c]["customMetrics"] if m["name"] == name), None)
                cells.append("-" if value is None else "%.2f" % value)
            lines.append("| %s (%s) | " % (name, unit) + " | ".join(cells) + " | %s |" % meanings.get(name, "-"))
        if environment["isSimulator"]:
            lines += ["", "> ⚠ 시뮬레이터 수치는 참고용입니다."]
        sections.append("\n".join(lines))
    return "\n\n".join(sections)


# ---------------------------------------------------------------------------
# chart / png / fingerprint


class ChartError(Exception):
    pass


CHART_COLORS = {"uikit": "#3478f6", "swiftui": "#ff9500"}
CHART_FONT = "-apple-system, 'Apple SD Gothic Neo', Helvetica, sans-serif"


def chart_values(topic, device, metric):
    """results/<device>/에서 `metric`의 값을 읽는다. 숫자는 여기서만 나온다 (직접 입력하는 경로가 없다)."""
    folder = topic.path / "results" / device
    if not folder.is_dir():
        raise ChartError("results/%s 없음" % device)
    common = {key: (title, fmt) for title, key, fmt in METRIC_ROWS}
    values, title, fmt, sample = {}, None, "%.2f", None
    for s in topic.stages:
        for f in topic.frameworks:
            path = folder / ("stage%d-%s.json" % (s, f))
            if not path.exists():
                raise ChartError("%s 없음" % path.name)
            sample = result = json.loads(path.read_text())
            if metric in common:
                title, fmt = common[metric]
                values[(s, f)] = result["metrics"][metric]
            else:
                found = next((m for m in result["customMetrics"] if m["name"] == metric), None)
                if found is None:
                    raise ChartError("%s에 지표 %s 없음" % (path.name, metric))
                title = "%s (%s)" % (metric, found["unit"])
                values[(s, f)] = found["value"]
    baseline = None
    if metric in common and (folder / ("%s.json" % BASELINE_RESULT)).exists():
        baseline = json.loads((folder / ("%s.json" % BASELINE_RESULT)).read_text())["metrics"][metric]
    return values, baseline, title, fmt, sample


def nice_ceiling(value):
    """축 최대값으로 쓸, `value` 이상의 가장 작은 보기 좋은 수 (1, 1.2, 1.6, 2, 3, 4, 5, 6, 8, 10 × 10^n). 눈금 4칸으로 나누어떨어진다."""
    if value <= 0:
        return 1.0
    exponent = 10.0 ** math.floor(math.log10(value))
    return next(step * exponent for step in (1, 1.2, 1.6, 2, 3, 4, 5, 6, 8, 10) if step * exponent >= value)


def chart_svg(topic, device, metric):
    """Stage × Framework 막대 차트 한 장. 차트 하나에 지표 하나, 기기 하나만 그리고 축은 0에서 시작한다."""
    values, baseline, title, fmt, sample = chart_values(topic, device, metric)
    environment = sample["environment"]

    def label(value):
        return "%.1f" % value if fmt == "%d" and value != int(value) else fmt % value

    width, height = 720, 420
    left, right, top, bottom = 64, 24, 84, 56
    plot_width, plot_height = width - left - right, height - top - bottom
    maximum = nice_ceiling(max(list(values.values()) + [baseline or 0]) * 1.08)
    frameworks, stages = topic.frameworks, topic.stages
    group_width = plot_width / len(stages)
    bar_width = min(72, group_width * 0.7 / len(frameworks))

    def y(value):
        return top + plot_height * (1 - value / maximum)

    subtitle = "%s · iOS %s · %s · %.0f초 × %d회 중앙값%s" % (
        environment["deviceModel"], environment["systemVersion"], environment["buildConfiguration"],
        sample["metrics"]["durationSeconds"], sample.get("repeat", 1),
        " · 시뮬레이터(참고용)" if environment["isSimulator"] else "")
    out = [
        '<svg xmlns="http://www.w3.org/2000/svg" width="%d" height="%d" viewBox="0 0 %d %d" font-family="%s">'
        % (width, height, width, height, CHART_FONT),
        '<rect width="%d" height="%d" fill="#ffffff"/>' % (width, height),
        '<text x="%d" y="34" font-size="20" font-weight="600" fill="#1c1c1e">%s</text>' % (left, title),
        '<text x="%d" y="58" font-size="13" fill="#6e6e73">%s</text>' % (left, subtitle),
    ]
    for tick in range(5):
        value = maximum * tick / 4
        out.append('<line x1="%d" y1="%.1f" x2="%d" y2="%.1f" stroke="%s" stroke-width="1"/>'
                   % (left, y(value), width - right, y(value), "#8e8e93" if tick == 0 else "#e5e5ea"))
        out.append('<text x="%d" y="%.1f" font-size="12" fill="#6e6e73" text-anchor="end">%g</text>'
                   % (left - 8, y(value) + 4, value))
    for index, s in enumerate(stages):
        center = left + group_width * (index + 0.5)
        start = center - bar_width * len(frameworks) / 2
        for offset, f in enumerate(frameworks):
            value = values[(s, f)]
            x = start + bar_width * offset
            out.append('<rect x="%.1f" y="%.1f" width="%.1f" height="%.1f" fill="%s"/>'
                       % (x + 3, y(value), bar_width - 6, top + plot_height - y(value), CHART_COLORS[f]))
            out.append('<text x="%.1f" y="%.1f" font-size="13" font-weight="600" fill="#1c1c1e" text-anchor="middle">%s</text>'
                       % (x + bar_width / 2, y(value) - 6, label(value)))
        out.append('<text x="%.1f" y="%d" font-size="14" fill="#1c1c1e" text-anchor="middle">S%d %s</text>'
                   % (center, height - bottom + 24, s, STAGE_TITLES[s]))
    if baseline is not None:
        out.append('<line x1="%d" y1="%.1f" x2="%d" y2="%.1f" stroke="#34c759" stroke-width="1.5" stroke-dasharray="6 4"/>'
                   % (left, y(baseline), width - right, y(baseline)))
    legend_x = width - right
    entries = [(CHART_COLORS[f], FRAMEWORK_TITLES[f]) for f in frameworks]
    if baseline is not None:
        entries.append(("#34c759", "Baseline %s (빈 화면)" % label(baseline)))
    for color, name in reversed(entries):
        text_width = sum(13 if ord(c) > 0x2E80 else 7.5 for c in name)
        legend_x -= text_width
        out.append('<text x="%.1f" y="34" font-size="13" fill="#1c1c1e">%s</text>' % (legend_x, name))
        legend_x -= 18
        out.append('<rect x="%.1f" y="24" width="12" height="12" fill="%s"/>' % (legend_x, color))
        legend_x -= 16
    out.append("</svg>")
    return "\n".join(out) + "\n"


def default_chart_device(topic):
    """실기기 결과가 있으면 실기기를 쓴다. 시뮬레이터는 참고용이라 실기기가 없을 때만 쓴다."""
    devices = [d for d, files in result_sets(topic).items() if expected_results(topic) <= files]
    if not devices:
        fail("모든 조합의 결과가 있는 기기가 없습니다. 먼저 `scripts/perflab measure %s`" % topic.id)
    real = [d for d in devices if not d.endswith("-simulator")]
    return (real or devices)[0]


def write_png(svg_path):
    """SVG를 PNG_SCALE배 크기의 PNG로 바꾼다 (Tistory 같은 블로그는 Mermaid나 SVG를 그리지 못한다).

    sips는 macOS 기본 이미지 변환 도구다. SVG에 적힌 width/height대로 그리므로, 크기만 키운 사본을 만들어 넘긴다.
    """
    text = svg_path.read_text()
    root = re.search(r"<svg[^>]*>", text)
    size = root and re.search(r'\swidth="([\d.]+)"', root.group(0)), root and re.search(r'\sheight="([\d.]+)"', root.group(0))
    if not root or not all(size):
        fail("%s: <svg>에 width, height(px)와 viewBox가 있어야 PNG로 바꿀 수 있습니다." % svg_path.name)
    if "viewBox" not in root.group(0):
        fail("%s: <svg>에 viewBox가 없습니다. 크기를 키우면 그림이 잘립니다." % svg_path.name)
    scaled = root.group(0)
    for name, match in zip(("width", "height"), size):
        scaled = scaled.replace(match.group(0), ' %s="%g"' % (name, float(match.group(1)) * PNG_SCALE), 1)
    with tempfile.TemporaryDirectory(prefix="perflab-") as work:
        source = Path(work) / svg_path.name
        source.write_text(text.replace(root.group(0), scaled, 1))
        target = svg_path.with_suffix(".png")
        result = subprocess.run(["sips", "-s", "format", "png", str(source), "--out", str(target)],
                                capture_output=True, text=True)
        if result.returncode != 0 or not target.exists():
            fail("PNG 변환 실패: %s\n%s" % (svg_path.name, result.stderr.strip()))
    return target


def cmd_chart(args):
    topic = find_topic(args.topic)
    device = args.device or default_chart_device(topic)
    assets = topic.path / "docs" / ASSETS_DIR
    assets.mkdir(parents=True, exist_ok=True)
    for metric in args.metric:
        try:
            svg = chart_svg(topic, device, metric)
        except ChartError as error:
            fail(str(error))
        path = assets / ("%s%s-%s.svg" % (CHART_PREFIX, device, metric))
        path.write_text(svg)
        print("✔ %s, %s" % (path.relative_to(ROOT), write_png(path).name))


def cmd_png(args):
    topic = find_topic(args.topic)
    files = sorted((topic.path / "docs" / ASSETS_DIR).glob("*.svg"))
    if not files:
        fail("docs/%s/에 SVG가 없습니다." % ASSETS_DIR)
    for path in files:
        print("✔ %s" % write_png(path).relative_to(ROOT))


def cmd_fingerprint(args):
    print(fingerprint(find_topic(args.topic)))


def replace_between(text, start, end, body):
    pattern = re.compile(re.escape(start) + r".*?" + re.escape(end), re.DOTALL)
    if not pattern.search(text):
        fail("마커를 찾을 수 없습니다: %s" % start)
    return pattern.sub(lambda _: "%s\n%s\n%s" % (start, body, end), text)


def cmd_table(args):
    topic = find_topic(args.topic)
    body = results_markdown(topic)
    if not body:
        fail("results/에 측정 결과가 없습니다. 먼저 `scripts/perflab measure %s`" % topic.id)
    path = topic.doc("RESULTS.md")
    path.write_text(replace_between(path.read_text(), RESULTS_START, RESULTS_END, body))
    print("✔ %s 결과표 갱신" % path.relative_to(ROOT))


def cmd_readme(args):
    rows = ["| # | 카테고리 | 주제 | 키워드 | 프레임워크 | 상태 | 문서 |", "|:---:|---|---|---|---|---|---|"]
    for topic in all_topics():
        meta = topic.meta
        summary = topic.relpath / "docs" / "SUMMARY.md"
        doc = "[Summary](%s)" % summary if topic.status in ("summarized", "archived") else "-"
        rows.append("| %02d | %s | %s | %s | %s | %s | %s |" % (
            meta["number"],
            CATEGORIES[meta["category"]][1],
            meta["title"],
            " ".join("`%s`" % t for t in meta["tags"]),
            ", ".join(FRAMEWORK_TITLES[f] for f in meta["frameworks"]),
            meta["status"],
            doc,
        ))
    if len(rows) == 2:
        rows.append("| - | - | 아직 주제가 없습니다 | - | - | - | - |")
    README.write_text(replace_between(README.read_text(), README_START, README_END, "\n".join(rows)))
    print("✔ README Topics 표 갱신")


def cmd_devices(args):
    subprocess.run(["xcrun", "xctrace", "list", "devices"], cwd=ROOT)


# ---------------------------------------------------------------------------
# build / format / lint


def cmd_build(args):
    destination = destination_for(args.device)
    cmd = ["xcodebuild", "build", "-project", str(PROJECT), "-scheme", "PerfLab", "-destination", destination, "-quiet"]
    print("$ " + " ".join(cmd))
    if subprocess.run(cmd, cwd=ROOT).returncode != 0:
        fail("빌드 실패")

    # 앱 스킴 빌드는 로컬 패키지의 컴파일러 경고를 숨긴다. 패키지 스킴으로 따로 빌드해 경고를 확인한다.
    warnings = []
    for package, scheme in ((ROOT / "Packages" / "Shared", "Shared"), (TOPICS_PACKAGE, topics_scheme())):
        result = subprocess.run(["xcodebuild", "build", "-scheme", scheme, "-destination", destination],
                                cwd=package, capture_output=True, text=True)
        if result.returncode != 0:
            print(result.stdout[-3000:])
            fail("%s 패키지 빌드 실패" % scheme)
        warnings += sorted({line.replace(str(ROOT) + "/", "") for line in result.stdout.splitlines()
                            if re.search(r"\.swift:\d+:\d+: warning:", line)})
    for line in warnings:
        print(line)
    if warnings:
        fail("컴파일러 경고 %d건. 경고 0건을 유지한다." % len(warnings))
    print("✔ 빌드 성공 (경고 0건)")


def swift_files(paths):
    """git이 추적하거나 무시하지 않는 Swift 파일 (.build 등 산출물 제외)."""
    targets = [str(Path(p).resolve().relative_to(ROOT)) for p in paths] if paths else []
    output = subprocess.run(["git", "ls-files", "-co", "--exclude-standard", "--", *targets],
                            cwd=ROOT, capture_output=True, text=True).stdout
    return [ROOT / line for line in output.splitlines() if line.endswith(".swift") and (ROOT / line).exists()]


def swift_format_lint(paths):
    files = swift_files(paths)
    if not files:
        return []
    result = subprocess.run(["xcrun", "swift-format", "lint", *map(str, files)], cwd=ROOT,
                            capture_output=True, text=True)
    return [line for line in result.stderr.splitlines() if ": warning: " in line or ": error: " in line]


def cmd_format(args):
    files = swift_files(args.paths)
    run(["xcrun", "swift-format", "format", "--in-place", *map(str, files)])
    print("✔ %d개 파일 포맷" % len(files))


def cmd_lint(args):
    errors = swift_format_lint(args.paths)
    for line in errors:
        print(line.replace(str(ROOT) + "/", ""))
    if errors:
        fail("swift-format lint 위반 %d건 (`scripts/perflab format`으로 자동 수정)" % len(errors))
    print("✔ lint 통과")


# ---------------------------------------------------------------------------


def main():
    parser = argparse.ArgumentParser(prog="perflab", description="PerfLab 파이프라인 CLI")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("new", help="템플릿으로 새 주제 생성 (status: proposed)")
    p.add_argument("--category", required=True, help=", ".join(CATEGORIES))
    p.add_argument("--slug", required=True, help="kebab-case. 예) image-feed-scroll")
    p.add_argument("--title", required=True)
    p.add_argument("--summary", required=True)
    p.add_argument("--tags", required=True, help="쉼표 구분. 예) CoreGraphics,Thread")
    p.set_defaults(func=cmd_new)

    p = sub.add_parser("status", help="주제별 현재 상태와 다음 단계")
    p.add_argument("topic", nargs="?")
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("validate", help="상태 조건 검사")
    p.add_argument("topic")
    p.add_argument("--status", choices=STATUSES)
    p.set_defaults(func=cmd_validate)

    p = sub.add_parser("advance", help="다음 상태 조건을 검사하고 통과하면 전환")
    p.add_argument("topic")
    p.set_defaults(func=cmd_advance)

    p = sub.add_parser("test", help="주제 단위 테스트 (시나리오 결정성, Stage 정합성)")
    p.add_argument("topic")
    p.add_argument("--device", help="기본: %s 시뮬레이터" % DEFAULT_SIMULATOR)
    p.set_defaults(func=cmd_test)

    p = sub.add_parser("measure", help="모든 Stage×Framework 자동 측정 (Release)")
    p.add_argument("topic")
    p.add_argument("--device", help="실기기 이름 또는 xcodebuild destination. 기본: 시뮬레이터")
    p.add_argument("--repeat", type=int, default=DEFAULT_REPEAT, help="조합별 반복 횟수 (중앙값 사용)")
    p.add_argument("--duration", type=float, default=10)
    p.add_argument("--warmup", type=float, default=2)
    p.add_argument("--allow-incomplete", action="store_true", help="Stage 구현이 끝나지 않아도 측정 (파이프라인 점검용)")
    p.set_defaults(func=cmd_measure)

    p = sub.add_parser("table", help="results/로 RESULTS.md 결과표 생성")
    p.add_argument("topic")
    p.set_defaults(func=cmd_table)

    p = sub.add_parser("fingerprint", help="주제 Swift 소스의 지문 (VERIFICATION.md에 기록, 검증 뒤 변경 감지)")
    p.add_argument("topic")
    p.set_defaults(func=cmd_fingerprint)

    p = sub.add_parser("chart", help="results/로 docs/assets/에 지표 차트(SVG+PNG) 생성")
    p.add_argument("topic")
    p.add_argument("--metric", action="append", required=True,
                   help="지표 이름. 공통: fpsAverage, hitchTimeRatio, cpuAverage 등 / 커스텀: PLAN.md의 이름. 여러 번 쓸 수 있다")
    p.add_argument("--device", help="results/ 아래 폴더 이름. 기본: 실기기 결과 (없으면 시뮬레이터)")
    p.set_defaults(func=cmd_chart)

    p = sub.add_parser("png", help="docs/assets/의 모든 SVG를 PNG로 변환 (블로그 업로드용)")
    p.add_argument("topic")
    p.set_defaults(func=cmd_png)

    p = sub.add_parser("readme", help="README Topics 표 갱신")
    p.set_defaults(func=cmd_readme)

    p = sub.add_parser("devices", help="측정 가능한 기기 목록")
    p.set_defaults(func=cmd_devices)

    p = sub.add_parser("build", help="앱 빌드 (기본: %s 시뮬레이터)" % DEFAULT_SIMULATOR)
    p.add_argument("--device")
    p.set_defaults(func=cmd_build)

    p = sub.add_parser("format", help="swift-format으로 코드 정리 (기본: 레포 전체)")
    p.add_argument("paths", nargs="*")
    p.set_defaults(func=cmd_format)

    p = sub.add_parser("lint", help="swift-format 규칙 검사 (기본: 레포 전체)")
    p.add_argument("paths", nargs="*")
    p.set_defaults(func=cmd_lint)

    args = parser.parse_args()
    sys.stdout.reconfigure(line_buffering=True)
    args.func(args)


if __name__ == "__main__":
    main()
